{
  "schema_version": "2",
  "dataset_name": "test_pdf_v1_image_analysis",
  "description": "Hand-curated evaluation dataset for the current test.pdf: 'Analiza Imaginilor: Indrumar de Laborator' (Vertan, Ciuc, Zamfir, 2001) — Romanian image-processing textbook. Replaces the stale Romanian-Penal-Code datasets after the universality domain shift. Small by design (10 questions) — enough to detect regressions; use enterprise_v3.json's regen once the pickle cache is warm.",
  "allowed_difficulties": [
    "easy",
    "medium",
    "hard"
  ],
  "allowed_types": [
    "single_hop",
    "lexical_exact",
    "conceptual",
    "multi_hop"
  ],
  "documents": [
    {
      "path": "../test.pdf",
      "doc_id": "image_analysis_textbook",
      "source": "vertan_ciuc_zamfir_2001"
    }
  ],
  "questions": [
