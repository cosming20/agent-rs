# ============================================================
# Agentic RAG — Infrastructure Environment Variables
# ============================================================
# Copy to .env and change all 'changeme' values before use.
# Docker Compose resolves .env relative to this directory.
# ============================================================

# --- Host Ports (1050-1060 range) ---
QDRANT_GRPC_PORT=1050
QDRANT_HTTP_PORT=1051
OPENSEARCH_PORT=1052
OPENSEARCH_PERF_PORT=1053
POSTGRES_PORT=1054
OPA_PORT=1055
# Port 1056 is reserved for Hayhooks (Phase 8) — do not allocate
OTEL_COLLECTOR_PORT=1057
JAEGER_UI_PORT=1058

# --- Qdrant ---
QDRANT_API_KEY=changeme-qdrant-key

# --- OpenSearch ---
OPENSEARCH_USER=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMeOpenSearch1!
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# --- PostgreSQL ---
POSTGRES_USER=agentic_ra
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=agentic_ra

# --- OPA ---
OPA_LOG_LEVEL=info
