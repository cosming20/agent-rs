# ============================================================
# Agentic RAG — Infrastructure Environment Variables
# ============================================================
# Copy to .env and change all 'changeme' values before use.
# Two prefixes live in this file:
#  - PLAIN vars (QDRANT_*, POSTGRES_*, NEO4J_*) are consumed by
#    docker-compose.yml to configure the containers.
#  - AGENT_RS__* vars are consumed by the Rust app via figment
#    (crates/core/src/config.rs) — the '__' is the nesting separator.
# Both sets must be kept in sync; the AGENT_RS__* values tell the
# Rust app HOW to talk to the services configured by the plain vars.
# ============================================================

# --- Host Ports (1050-1066 range) ---
QDRANT_GRPC_PORT=1050
QDRANT_HTTP_PORT=1051
POSTGRES_PORT=1054
OPA_PORT=1055
HAYHOOKS_PORT=1056
OTEL_COLLECTOR_PORT=1057
JAEGER_UI_PORT=1058
PROMETHEUS_PORT=1066
# 1059 = API Gateway
# 1060 = Reserved
# 1061 = Neo4j Bolt
# 1062 = Neo4j HTTP
# 1063 = Brave Search MCP

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_API_KEY=changeme-qdrant-key

# --- PostgreSQL ---
POSTGRES_USER=agentic_ra
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=agentic_ra
POSTGRES_HOST=localhost

# --- OPA ---
OPA_LOG_LEVEL=info

# --- LLM Provider (LiteLLM format: provider/model) ---
# Supports: openai/gpt-4o, anthropic/claude-sonnet-4-20250514, ollama/llama3, etc.
LLM_API_KEY=sk-changeme
LLM_PROVIDER_MODEL=openai/gpt-4o
LLM_VERIFIER_MODEL=openai/gpt-4o-mini
LLM_ENRICHMENT_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Embedding + Chunking (Docling) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
CHUNK_MAX_TOKENS=2048
CHUNK_MERGE_PEERS=true

# --- Neo4j (Cognee graph backend) ---
NEO4J_BOLT_PORT=1061
NEO4J_HTTP_PORT=1062
NEO4J_HOST=localhost
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j
NEO4J_DB=neo4j

# --- Cognee (Knowledge Graph) ---
COGNEE_ENABLED=true
COGNEE_DATASET=agentic_rag
COGNEE_GRAPH_DB_PROVIDER=neo4j
COGNEE_VECTOR_DB_PROVIDER=qdrant
# Cognee 0.5.5+ multi-user access control (disable for dev/single-user)
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- Brave Search MCP ---
BRAVE_API_KEY=changeme-brave-key
BRAVE_MCP_HOST=brave-search-mcp
BRAVE_MCP_PORT=1063
BRAVE_SEARCH_ENABLED=false

# --- Fetch ---
FETCH_MAX_LENGTH=5000
FETCH_MAX_BYTES=2000000
FETCH_TIMEOUT=30
FETCH_USER_AGENT=AgenticRA/1.0
FETCH_MAX_REDIRECTS=3
FETCH_DOMAIN_DENYLIST=
FETCH_DOMAIN_ALLOWLIST=

# --- Grafana ---
GRAFANA_PORT=1067
GRAFANA_ADMIN_PASSWORD=admin  # CHANGE IN PRODUCTION

# --- Web Tool Budgets ---
WEB_BUDGET_MAX_SEARCHES=3
WEB_BUDGET_MAX_NEWS=2
WEB_BUDGET_MAX_FETCHES=3
WEB_BUDGET_TIMEOUT_S=45.0
WEB_BUDGET_MAX_BYTES=6000000

# --- Feedback (Loop 1) ---
FEEDBACK_ENABLED=true
FEEDBACK_ALPHA=0.1
FEEDBACK_DRY_RUN=false
FEEDBACK_WEIGHT_FLOOR=0.1
FEEDBACK_WEIGHT_CEILING=0.9

# --- Strategy Learning (Loop 2) ---
STRATEGY_LEARNING_ENABLED=false
STRATEGY_COLLECTION=query_strategies
STRATEGY_MIN_NEIGHBORS=5
STRATEGY_CONFIDENCE_THRESHOLD=0.1
STRATEGY_MAX_AGE_DAYS=30

# --- RuVector (Loop 3) ---
RUVECTOR_ENABLED=false
RUVECTOR_HTTP_PORT=1064
RUVECTOR_GRPC_PORT=1065
RUVECTOR_URL=http://localhost:1064
RUVECTOR_API_KEY=
GNN_TRAINING_ENABLED=false
GNN_TRAINING_INTERVAL_HOURS=24
GNN_TRAINING_MIN_SAMPLES=50

# --- Agent ---
AGENT_MAX_STEPS=10
AGENT_MAX_RETRIES=1
SYSTEM_PROMPT_FILE=

# --- Orchestrator ---
CONTEXT_MAX_MESSAGES=4
CONTEXT_MAX_CHARS_PER_MSG=150

# --- Tool limits ---
MAX_EVIDENCE_CHARS=16000
MAX_CONTEXT_CHARS=300

# --- Synthesis ---
MAX_SNIPPET_LENGTH=200

# --- Ranker ---
RRF_K=60

# --- Verifier ---
VERIFIER_CONFIDENCE_THRESHOLD=0.5

# --- Postgres connection pool ---
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# --- Cognee chunking ---
COGNEE_CHUNK_SIZE=16000
COGNEE_CHUNK_OVERLAP=0

# --- Upload ---
UPLOAD_MAX_FILE_SIZE=50000000
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.html,.htm,.txt,.md

# --- Admin ---
ADMIN_MAX_FAN_OUT=50
ADMIN_CONCURRENT_SEARCHES=5

# --- OTel Prometheus exporter ---
OTEL_PROMETHEUS_PORT=8889

# ============================================================
# AGENT_RS__* — mirrors of the above, consumed by the Rust app
# via figment. Same values, nested-key prefix + '__' separator.
# ============================================================

# --- Qdrant (how the Rust client authenticates + connects) ---
AGENT_RS__QDRANT__HOST=localhost
AGENT_RS__QDRANT__GRPC_PORT=1050
AGENT_RS__QDRANT__HTTP_PORT=1051
AGENT_RS__QDRANT__API_KEY=changeme-qdrant-key

# --- Postgres ---
AGENT_RS__POSTGRES__HOST=localhost
AGENT_RS__POSTGRES__PORT=1054
AGENT_RS__POSTGRES__USER=agentic_ra
AGENT_RS__POSTGRES__PASSWORD=changeme-postgres
AGENT_RS__POSTGRES__DB=agentic_ra

# --- Neo4j ---
AGENT_RS__NEO4J__HOST=localhost
AGENT_RS__NEO4J__BOLT_PORT=1061
AGENT_RS__NEO4J__USER=neo4j
AGENT_RS__NEO4J__PASSWORD=changeme-neo4j

# --- OpenTelemetry collector (traces → Jaeger, metrics → Prometheus) ---
AGENT_RS__OTEL__HOST=localhost
AGENT_RS__OTEL__COLLECTOR_PORT=1057

# --- Docling sidecar (gRPC client endpoint) ---
AGENT_RS__DOCLING__ENDPOINT=http://localhost:1068

# --- Docling server-side tuning (read by the sidecar, not the Rust app) ---
# Accelerator: cpu | cuda | mps | auto. auto = detect via torch.
# NOTE: MPS is NOT reachable from Docker on macOS. For Metal on Apple
# Silicon run `just docling-native` instead of `docker compose up docling-sidecar`.
DOCLING_ACCELERATOR=auto
# TableFormer: accurate (default) or fast. accurate handles complex nested
# tables (merged cells, multi-row headers) at ~40% more latency and
# 3-4 GB more peak memory. fast is indistinguishable on simple tables
# and text-heavy docs — use it when Docker Desktop VM is <12 GB.
DOCLING_TABLEFORMER_MODE=accurate

# --- Ingest backend ('docling' recommended; 'legacy' falls back to pdf-extract) ---
AGENT_RS__INGEST_BACKEND=docling

# --- LLM (used by GraphCoT, QueryRewriter, etc.) ---
AGENT_RS__LLM__API_KEY=sk-changeme
AGENT_RS__LLM__MODEL=gpt-5.4-mini-2026-03-17
