# agent-rs configuration
# All env vars use AGENT_RS__ prefix with __ separator for nesting.
# Example: AGENT_RS__QDRANT__HOST maps to settings.qdrant.host

# LLM
AGENT_RS__LLM__API_KEY=sk-...
AGENT_RS__LLM__MODEL=gpt-4o

# Qdrant
AGENT_RS__QDRANT__HOST=localhost
AGENT_RS__QDRANT__HTTP_PORT=1051
AGENT_RS__QDRANT__GRPC_PORT=1050
AGENT_RS__QDRANT__API_KEY=

# PostgreSQL
AGENT_RS__POSTGRES__HOST=localhost
AGENT_RS__POSTGRES__PORT=1054
AGENT_RS__POSTGRES__USER=agentic
AGENT_RS__POSTGRES__PASSWORD=agentic
AGENT_RS__POSTGRES__DB=agentic_rag

# Neo4j
AGENT_RS__NEO4J__HOST=localhost
AGENT_RS__NEO4J__BOLT_PORT=1061
AGENT_RS__NEO4J__USER=neo4j
AGENT_RS__NEO4J__PASSWORD=neo4j

# Agent
AGENT_RS__AGENT__MAX_STEPS=10
AGENT_RS__AGENT__MAX_RETRIES=1
AGENT_RS__AGENT__SYSTEM_PROMPT_FILE=

# Context
AGENT_RS__CONTEXT__MAX_MESSAGES=4
AGENT_RS__CONTEXT__MAX_CHARS_PER_MSG=150

# Evidence
AGENT_RS__EVIDENCE__MAX_EVIDENCE_CHARS=16000
AGENT_RS__EVIDENCE__MAX_CONTEXT_CHARS=300

# Synthesis
AGENT_RS__SYNTHESIS__MAX_SNIPPET_LENGTH=200

# Verifier
AGENT_RS__VERIFIER__CONFIDENCE_THRESHOLD=0.5

# Ranker
AGENT_RS__RANKER__RRF_K=60

# Web Budget
AGENT_RS__WEB_BUDGET__MAX_SEARCHES=3
AGENT_RS__WEB_BUDGET__MAX_NEWS=2
AGENT_RS__WEB_BUDGET__MAX_FETCHES=3
AGENT_RS__WEB_BUDGET__TIMEOUT_S=45.0
AGENT_RS__WEB_BUDGET__MAX_BYTES=6000000

# Fetch
AGENT_RS__FETCH__MAX_LENGTH=5000
AGENT_RS__FETCH__MAX_BYTES=2000000
AGENT_RS__FETCH__TIMEOUT=30
AGENT_RS__FETCH__MAX_REDIRECTS=3

# Retrieval
AGENT_RS__RETRIEVAL__DATASET=default
AGENT_RS__RETRIEVAL__OFFLINE=false

# OTel
AGENT_RS__OTEL__HOST=localhost
AGENT_RS__OTEL__COLLECTOR_PORT=1057

# OPA
AGENT_RS__OPA__HOST=localhost
AGENT_RS__OPA__PORT=1055

# Ingestion backend: "legacy" | "docling" | "docling_with_legacy_fallback"
AGENT_RS__INGEST_BACKEND=docling
AGENT_RS__DOCLING__ENDPOINT=http://localhost:1068
