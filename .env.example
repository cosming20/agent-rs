# ============================================================
# Agentic RAG — Infrastructure Environment Variables
# ============================================================
# Copy to .env and change all 'changeme' values before use.
# Docker Compose reads infra/.env via a symlink to this file.
# ============================================================

# --- Host Ports (1050-1062 range) ---
QDRANT_GRPC_PORT=1050
QDRANT_HTTP_PORT=1051
POSTGRES_PORT=1054
OPA_PORT=1055
HAYHOOKS_PORT=1056
OTEL_COLLECTOR_PORT=1057
JAEGER_UI_PORT=1058
# 1059 = API Gateway
# 1060 = Reserved
# 1061 = Neo4j Bolt
# 1062 = Neo4j HTTP

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_API_KEY=changeme-qdrant-key

# --- PostgreSQL ---
POSTGRES_USER=agentic_ra
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=agentic_ra
POSTGRES_HOST=localhost

# --- OPA ---
OPA_LOG_LEVEL=info

# --- OpenAI ---
OPENAI_API_KEY=sk-changeme
LLM_MODEL=gpt-4o-mini

# --- Embedding + Chunking (Docling) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
CHUNK_MAX_TOKENS=512
CHUNK_MERGE_PEERS=true

# --- Neo4j (Cognee graph backend) ---
NEO4J_BOLT_PORT=1061
NEO4J_HTTP_PORT=1062
NEO4J_HOST=localhost
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j
NEO4J_DB=neo4j

# --- Cognee (Knowledge Graph) ---
COGNEE_ENABLED=true
COGNEE_DATASET=agentic_rag
COGNEE_GRAPH_DB_PROVIDER=neo4j
COGNEE_VECTOR_DB_PROVIDER=qdrant
# Cognee 0.5.5+ multi-user access control (disable for dev/single-user)
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- Brave Search MCP ---
BRAVE_API_KEY=changeme-brave-key
BRAVE_MCP_HOST=brave-search-mcp
BRAVE_MCP_PORT=1063
BRAVE_SEARCH_ENABLED=false

# --- Fetch ---
FETCH_MAX_LENGTH=5000
FETCH_MAX_BYTES=2000000
FETCH_TIMEOUT=30
FETCH_USER_AGENT=AgenticRA/1.0
FETCH_MAX_REDIRECTS=3
FETCH_DOMAIN_DENYLIST=
FETCH_DOMAIN_ALLOWLIST=

# --- Web Tool Budgets ---
WEB_BUDGET_MAX_SEARCHES=3
WEB_BUDGET_MAX_NEWS=2
WEB_BUDGET_MAX_FETCHES=3
WEB_BUDGET_TIMEOUT_S=45.0
WEB_BUDGET_MAX_BYTES=6000000
